[gd_scene format=3 uid="uid://chatlog001"]

[ext_resource type="Script" path="res://scripts/chatlog_ui.gd" id="1_script"]

[node name="ChatLogUI" type="CanvasLayer"]
script = ExtResource("1_script")
visible = false

[node name="Panel" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 180.0
offset_top = 40.0
offset_right = -40.0
offset_bottom = -40.0

[node name="VBox" type="VBoxContainer" parent="Panel"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 12.0
offset_right = -16.0
offset_bottom = -12.0

[node name="Title" type="Label" parent="Panel/VBox"]
text = "NPC 聊天记录"
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)

[node name="LogList" type="RichTextLabel" parent="Panel/VBox"]
size_flags_vertical = 3
bbcode_enabled = true
scroll_following = true
theme_override_font_sizes/font_size = 12
theme_override_colors/default_color = Color(0.9, 0.9, 0.9, 1)

[node name="CloseHint" type="Label" parent="Panel/VBox"]
text = "[L] 关闭"
horizontal_alignment = 2
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 1)
